{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "managerConfig": {
      "type": "object",
      "description": "Omit mode or set it to yaml for legacy configuration. Set mode to structured to use structuredOverrides instead.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "yaml",
            "structured"
          ]
        }
      },
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "structured"
          }
        }
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "mode": {
          },
          "structuredOverrides": {
            "type": "object"
          },
          "controllerManagerConfigYaml": {
          }
        }
      }
    }
  },
  "$comment": "Copyright The Kubernetes Authors. Licensed under the Apache License, Version 2.0; see https://www.apache.org/licenses/LICENSE-2.0."
}

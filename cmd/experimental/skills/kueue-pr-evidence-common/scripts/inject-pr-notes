"""Idempotently place one pr-evidence block in a PR body's reviewer-notes section.

Conventions: cmd/experimental/skills/kueue-pr-evidence-common/SKILL.md.
Python 3 standard library only.

    inject-pr-notes --pr <num|url> --skill kueue-pr-evidence-<name> --file <block.md> \
        --base <sha> --head <sha> [--repo kubernetes-sigs/kueue] [--dry-run]

Exit codes: 0 ok / no change, 1 gh failure, 2 usage or malformed body, 3 refused.
"""

from __future__ import annotations

import argparse
import difflib
import json
import os
import re
import subprocess
import sys
import tempfile

SECTION_TITLE = "Useful notes for your reviewer"
SECTION_HEADING = "#### " + SECTION_TITLE
DEFAULT_REPO = "kubernetes-sigs/kueue"
DEFAULT_MAX_VISIBLE_LINES = 25
GITHUB_BODY_LIMIT = 65536

SKILL_RE = re.compile(r"^kueue-pr-evidence-[a-z0-9]+(?:-[a-z0-9]+)*$")
SHA_RE = re.compile(r"^[0-9a-f]{7,40}$")
HEADING_RE = re.compile(r"^ {0,3}(#{1,6})[ \t]+(.*?)[ \t#]*$")
FENCE_RE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
MARKER_RE = re.compile(r"<!--\s*pr-evidence:([a-z0-9-]+):(start|end)\s*-->")
RELEASE_NOTE_TITLE_RE = re.compile(r"^release[ -]?notes?:?$", re.IGNORECASE)
PR_URL_RE = re.compile(r"^https?://github\.com/([^/]+/[^/]+)/pull/(\d+)(?:[/?#].*)?$")


class InjectError(Exception):
    """Malformed input or body; exit 2."""


class Refused(Exception):
    """Safety refusal (author / stale head); exit 3."""


def markers(skill: str) -> tuple[str, str]:
    return f"<!-- pr-evidence:{skill}:start -->", f"<!-- pr-evidence:{skill}:end -->"


def header_line(skill: str, base: str, head: str) -> str:
    # Plain (non-code) SHAs so GitHub autolinks them to commits.
    return f"**{skill}** base {base[:12]} -> head {head[:12]}"


def visible_lines(content: str) -> int:
    """Non-blank lines a reviewer sees without expanding <details>.

    The <details> opening line (summary) counts once; its body does not.
    """
    depth = 0
    count = 0
    for line in content.split("\n"):
        opens = len(re.findall(r"<details\b", line, re.IGNORECASE))
        closes = len(re.findall(r"</details\s*>", line, re.IGNORECASE))
        if depth == 0 and line.strip():
            count += 1
        depth = max(0, depth + opens - closes)
    return count


def render_block(skill: str, content: str, base: str, head: str) -> list[str]:
    start, end = markers(skill)
    body = content.replace("\r\n", "\n").strip("\n")
    lines = [start, header_line(skill, base, head)]
    if body:
        lines += [""] + body.split("\n")
    lines.append(end)
    return lines


def _validate_markers(lines: list[str]) -> dict[str, tuple[int, int]]:
    """Return {skill: (start_idx, end_idx)}; raise on unbalanced/nested/inline markers."""
    spans: dict[str, tuple[int, int]] = {}
    open_skill: str | None = None
    open_idx = -1
    for i, line in enumerate(lines):
        found = MARKER_RE.findall(line)
        if not found:
            continue
        if len(found) != 1 or MARKER_RE.fullmatch(line.strip()) is None:
            raise InjectError(f"line {i + 1}: pr-evidence marker must be alone on its line")
        skill, kind = found[0]
        if kind == "start":
            if open_skill is not None:
                raise InjectError(f"line {i + 1}: nested pr-evidence block inside {open_skill}")
            if skill in spans:
                raise InjectError(f"duplicate pr-evidence block for {skill}")
            open_skill, open_idx = skill, i
        else:
            if open_skill != skill:
                raise InjectError(f"line {i + 1}: unmatched end marker for {skill}")
            spans[skill] = (open_idx, i)
            open_skill = None
    if open_skill is not None:
        raise InjectError(f"unterminated pr-evidence block for {open_skill}")
    return spans


def _structure(lines: list[str], spans: dict[str, tuple[int, int]]):
    """Yield (idx, level, title) for ATX headings and (idx, 0, fence-info) for
    release-note fences, skipping fenced code and pr-evidence blocks."""
    in_block = set()
    for s, e in spans.values():
        in_block.update(range(s, e + 1))
    fence: str | None = None
    for i, line in enumerate(lines):
        if i in in_block:
            continue
        m = FENCE_RE.match(line)
        if fence is not None:
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence) and not m.group(2).strip():
                fence = None
            continue
        if m:
            fence = m.group(1)
            if m.group(2).strip().lower().startswith("release-note"):
                yield i, 0, "release-note"
            continue
        h = HEADING_RE.match(line)
        if h:
            yield i, len(h.group(1)), h.group(2).strip()


def _is_section_title(title: str) -> bool:
    return title.rstrip(":").strip().lower() == SECTION_TITLE.lower()


def _insert_with_spacing(lines: list[str], at: int, new: list[str]) -> list[str]:
    before = lines[:at]
    after = lines[at:]
    if before and before[-1].strip():
        new = [""] + new
    if after and after[0].strip():
        new = new + [""]
    return before + new + after


def rewrite_body(body: str | None, skill: str, content: str, base: str, head: str) -> str:
    """Pure function: return the PR body with the skill block replaced or inserted."""
    if not SKILL_RE.match(skill):
        raise InjectError(f"skill must match {SKILL_RE.pattern}: {skill!r}")
    for name, sha in (("base", base), ("head", head)):
        if not SHA_RE.match(sha or ""):
            raise InjectError(f"--{name} must be a 7-40 char lowercase hex SHA: {sha!r}")
    if MARKER_RE.search(content or ""):
        raise InjectError("block file must not contain pr-evidence markers (the injector adds them)")

    body = body or ""
    newline = "\r\n" if "\r\n" in body else "\n"
    lines = body.replace("\r\n", "\n").split("\n")
    block = render_block(skill, content or "", base, head)
    spans = _validate_markers(lines)

    if skill in spans:
        s, e = spans[skill]
        lines = lines[:s] + block + lines[e + 1:]
        return newline.join(lines)

    structure = list(_structure(lines, spans))
    section = next(((i, lvl) for i, lvl, t in structure if lvl > 0 and _is_section_title(t)), None)

    if section is not None:
        sec_idx, sec_lvl = section
        end = len(lines)
        for i, lvl, title in structure:
            if i <= sec_idx:
                continue
            if lvl == 0 or lvl <= sec_lvl or RELEASE_NOTE_TITLE_RE.match(title):
                end = i
                break
        p = end
        while p > sec_idx + 1 and not lines[p - 1].strip():
            p -= 1
        lines = _insert_with_spacing(lines, p, block)
        return newline.join(lines)

    # No reviewer-notes section: create it before the release-note block.
    anchor = next((i for i, lvl, t in structure if lvl > 0 and RELEASE_NOTE_TITLE_RE.match(t)), None)
    if anchor is None:
        anchor = next((i for i, lvl, _ in structure if lvl == 0), None)
    new = [SECTION_HEADING, ""] + block
    if anchor is None:
        anchor = len(lines)
        while anchor > 0 and not lines[anchor - 1].strip():
            anchor -= 1
    lines = _insert_with_spacing(lines, anchor, new)
    return newline.join(lines)


def unified_diff(old: str, new: str, label: str) -> str:
    return "".join(
        difflib.unified_diff(
            old.replace("\r\n", "\n").splitlines(keepends=True),
            new.replace("\r\n", "\n").splitlines(keepends=True),
            fromfile=f"a/{label}",
            tofile=f"b/{label}",
        )
    )


def parse_pr(pr: str, repo: str) -> tuple[str, str]:
    m = PR_URL_RE.match(pr.strip())
    if m:
        return m.group(1), m.group(2)
    if re.fullmatch(r"#?\d+", pr.strip()):
        return repo, pr.strip().lstrip("#")
    raise InjectError(f"--pr must be a number or https://github.com/<owner>/<repo>/pull/<n>: {pr!r}")


def gh(*args: str) -> str:
    try:
        res = subprocess.run(["gh", *args], check=True, capture_output=True, text=True)
    except FileNotFoundError as exc:
        raise RuntimeError("gh CLI not found on PATH") from exc
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(f"gh {' '.join(args[:2])} failed: {exc.stderr.strip()}") from exc
    return res.stdout


def warn(msg: str) -> None:
    print(f"inject-pr-notes: {msg}", file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="inject-pr-notes", description=__doc__.split("\n\n")[0])
    ap.add_argument("--pr", help="PR number or URL (required unless --body-in)")
    ap.add_argument("--skill", required=True, help="full skill name, e.g. kueue-pr-evidence-state-diff")
    ap.add_argument("--file", required=True, help="markdown block content (no markers, no header)")
    ap.add_argument("--base", required=True, help="merge-base SHA the 'before' was generated from")
    ap.add_argument("--head", required=True, help="HEAD SHA the 'after' was generated from")
    ap.add_argument("--repo", default=DEFAULT_REPO, help=f"owner/name (default {DEFAULT_REPO})")
    ap.add_argument("--dry-run", action="store_true", help="print a unified diff of the body; change nothing")
    ap.add_argument("--allow-other-author", action="store_true", help="edit a PR you did not author")
    ap.add_argument("--allow-stale-head", action="store_true", help="allow --head != PR headRefOid")
    ap.add_argument("--max-visible-lines", type=int, default=DEFAULT_MAX_VISIBLE_LINES,
                    help=f"visible-line budget outside <details> (default {DEFAULT_MAX_VISIBLE_LINES})")
    ap.add_argument("--body-in", help="offline: read the current body from this file; never calls gh "
                                      "(prints diff with --dry-run, else the new body)")
    args = ap.parse_args(argv)

    try:
        with open(args.file, encoding="utf-8") as fh:
            content = fh.read()
        n_visible = visible_lines(content.replace("\r\n", "\n")) + 1  # + header line
        if n_visible > args.max_visible_lines:
            raise InjectError(
                f"block has {n_visible} visible lines > budget {args.max_visible_lines}; "
                "move overflow inside <details>")

        if args.body_in:
            with open(args.body_in, encoding="utf-8", newline="") as fh:
                old = fh.read()
            new = rewrite_body(old, args.skill, content, args.base, args.head)
            if args.dry_run:
                sys.stdout.write(unified_diff(old, new, "pr-body.md"))
            else:
                sys.stdout.write(new)
            return 0

        if not args.pr:
            raise InjectError("--pr is required (or use --body-in for offline mode)")
        repo, number = parse_pr(args.pr, args.repo)
        pr = json.loads(gh("pr", "view", number, "--repo", repo, "--json", "body,author,headRefOid,url,state"))
        old = pr.get("body") or ""
        new = rewrite_body(old, args.skill, content, args.base, args.head)

        author = (pr.get("author") or {}).get("login", "")
        me = gh("api", "user", "-q", ".login").strip()
        problems = []
        if author != me and not args.allow_other_author:
            problems.append(f"PR author {author!r} != gh user {me!r} (use --allow-other-author)")
        pr_head = pr.get("headRefOid") or ""
        if not pr_head.startswith(args.head) and not args.allow_stale_head:
            problems.append(f"--head {args.head[:12]} != PR head {pr_head[:12]}; push first "
                            "(or --allow-stale-head)")
        if len(new) > GITHUB_BODY_LIMIT:
            raise InjectError(f"new body is {len(new)} chars > GitHub limit {GITHUB_BODY_LIMIT}")
        if pr.get("state") and pr["state"] != "OPEN":
            warn(f"PR state is {pr['state']}")

        if args.dry_run:
            for p in problems:
                warn(f"would refuse: {p}")
            diff = unified_diff(old, new, f"{repo}#{number}.body")
            sys.stdout.write(diff or "no change\n")
            return 0
        if problems:
            raise Refused("; ".join(problems))
        if new == old:
            print(f"no change: {pr.get('url', number)} ({args.skill})")
            return 0
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", newline="", suffix=".md",
                                         delete=False) as tmp:
            tmp.write(new)
            tmp_path = tmp.name
        try:
            gh("pr", "edit", number, "--repo", repo, "--body-file", tmp_path)
        finally:
            os.unlink(tmp_path)
        print(f"updated: {pr.get('url', number)} ({args.skill})")
        return 0
    except InjectError as exc:
        warn(f"error: {exc}")
        return 2
    except Refused as exc:
        warn(f"refused: {exc}")
        return 3
    except (RuntimeError, json.JSONDecodeError, OSError) as exc:
        warn(f"error: {exc}")
        return 1


if __name__ == "__main__":
    sys.exit(main())

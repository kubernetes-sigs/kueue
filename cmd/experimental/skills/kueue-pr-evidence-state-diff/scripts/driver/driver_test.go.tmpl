}

func prevdCheck(g gomega.Gomega, w *prevdWait) {
	u, err := prevdGet(w.prevdRef)
	g.Expect(err).NotTo(gomega.HaveOccurred())
	if w.Condition != "" {
		conds, _, _ := unstructured.NestedSlice(u.Object, "status", "conditions")
		var found map[string]any
		for _, c := range conds {
			if cm := c.(map[string]any); cm["type"] == w.Condition {
				found = cm
			}
		}
		g.Expect(found).NotTo(gomega.BeNil(), "condition %s not present", w.Condition)
		g.Expect(found["status"]).To(gomega.Equal(w.Status), "condition %s status (reason %v)", w.Condition, found["reason"])
		if w.Reason != "" {
			g.Expect(found["reason"]).To(gomega.Equal(w.Reason), "condition %s reason", w.Condition)
		}
	}
	if w.Field != "" {
		v, ok := prevdField(u.Object, w.Field)
		if !ok {
			v = nil

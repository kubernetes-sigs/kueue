// prevdFingerprint is the settle key: everything the capture keeps, minus
// timestamps and resourceVersions, plus the number of events.
func prevdFingerprint(snap map[string]any) string {
	pick := func(items any, fields ...string) []any {
		var out []any
		for _, it := range items.([]any) {
			obj := it.(map[string]any)
			md, _ := obj["metadata"].(map[string]any)
			st, _ := obj["status"].(map[string]any)
			row := []any{md["namespace"], md["name"]}
			for _, f := range fields {
				v := st[f]
				if f == "conditions" && v != nil {
					var cs []any
					for _, c := range v.([]any) {
						cm := c.(map[string]any)
						cs = append(cs, []any{cm["type"], cm["status"], cm["reason"], cm["message"]})
					}
					v = cs
				}
				if f == "requeueState" && v != nil {
					v = v.(map[string]any)["count"]
				}
				row = append(row, v)
			}
			out = append(out, row)
		}
		return out
	}
	key := []any{
		pick(snap["workloads"], "conditions", "admission", "requeueState"),
		pick(snap["clusterQueues"], "pendingWorkloads", "reservingWorkloads", "admittedWorkloads", "flavorsUsage"),
		pick(snap["localQueues"], "pendingWorkloads", "reservingWorkloads", "admittedWorkloads"),
		len(snap["events"].([]any)),
	}
	b, err := json.Marshal(key)
	gomega.Expect(err).NotTo(gomega.HaveOccurred())
	return string(b)
}

// prevdSettle waits (assertion-backed, no sleeps) until the observed state is
// identical for prevdStablePolls consecutive polls and for at least `window`
// (longer than Kueue's 1s ClusterQueue status batch), then returns that snapshot.
func prevdSettle(timeout, window time.Duration) map[string]any {
	var last string
	var snap map[string]any
	var since time.Time
	stable := 0
	gomega.Eventually(func(g gomega.Gomega) {
		snap = prevdSnapshot()
		fp := prevdFingerprint(snap)
		if fp == last {
			stable++
		} else {
			stable, last, since = 1, fp, time.Now()
		}
		g.Expect(stable).To(gomega.BeNumerically(">=", prevdStablePolls), "state still changing")
		g.Expect(time.Since(since)).To(gomega.BeNumerically(">=", window), "state unchanged for less than the settle window")
	}).WithTimeout(timeout).WithPolling(prevdPoll).Should(gomega.Succeed())
	return snap
}


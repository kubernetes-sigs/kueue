func prevdApply(obj map[string]any) {
	u := &unstructured.Unstructured{Object: obj}
	status, hasStatus := obj["status"]
	delete(obj, "status")
	gomega.Expect(k8sClient.Create(ctx, u)).To(gomega.Succeed(), "create %s %s/%s", u.GetKind(), u.GetNamespace(), u.GetName())
	if hasStatus {
		u.Object["status"] = status
		gomega.Expect(k8sClient.Status().Update(ctx, u)).To(gomega.Succeed(), "status %s %s", u.GetKind(), u.GetName())
	}
	if u.GetKind() == "Node" && u.GetAPIVersion() == "v1" {
		prevdUntaintReadyNode(u.GetName())
	}
}

// prevdUntaintReadyNode mirrors the upstream CreateNodesWithStatus helper: envtest
// has no node lifecycle controller, so the not-ready taint added at creation
// stays unless removed once the applied status says Ready.
func prevdUntaintReadyNode(name string) {
	gomega.Eventually(func(g gomega.Gomega) {
		n := &corev1.Node{}
		g.Expect(k8sClient.Get(ctx, client.ObjectKey{Name: name}, n)).To(gomega.Succeed())
		ready := false
		for _, c := range n.Status.Conditions {
			ready = ready || (c.Type == corev1.NodeReady && c.Status == corev1.ConditionTrue)
		}
		if !ready {
			return
		}
		kept := n.Spec.Taints[:0]
		for _, t := range n.Spec.Taints {
			if t.Key != corev1.TaintNodeNotReady {
				kept = append(kept, t)
			}
		}
		if len(kept) == len(n.Spec.Taints) {
			return
		}
		n.Spec.Taints = kept
		g.Expect(k8sClient.Update(ctx, n)).To(gomega.Succeed())
	}).WithTimeout(10 * time.Second).WithPolling(prevdPoll).Should(gomega.Succeed(), "untaint node %s", name)
}

func prevdRun() {
	raw := &prevdRaw{Driver: "pr-evidence-state-diff/driver-v1", KueueAPIVersion: prevdKueueVersion, Checkpoints: []prevdCheckpoint{}}
	outPath := os.Getenv("PR_EVIDENCE_STATE_DIFF_OUT")
	gomega.Expect(outPath).NotTo(gomega.BeEmpty(), "PR_EVIDENCE_STATE_DIFF_OUT")
	write := func() {
		b, err := json.MarshalIndent(raw, "", "  ")
		gomega.Expect(err).NotTo(gomega.HaveOccurred())
		gomega.Expect(os.WriteFile(outPath, b, 0o644)).To(gomega.Succeed())
	}

	b, err := os.ReadFile(os.Getenv("PR_EVIDENCE_STATE_DIFF_SCENARIO"))
	gomega.Expect(err).NotTo(gomega.HaveOccurred())
	var sc prevdScenario
	gomega.Expect(json.Unmarshal(b, &sc)).To(gomega.Succeed())
	raw.Scenario = sc.Name
	settle := time.Duration(sc.SettleTimeoutSeconds * float64(time.Second))
	window := time.Duration(sc.SettleWindowSeconds * float64(time.Second))

	prevdSetGates()
	for _, ns := range sc.Namespaces {
		err := k8sClient.Create(ctx, &corev1.Namespace{ObjectMeta: metav1.ObjectMeta{Name: ns}})
		if !apierrors.IsAlreadyExists(err) {
			gomega.Expect(err).NotTo(gomega.HaveOccurred())
		}
	}

	var pending []string
	for i, st := range sc.Steps {
		action, assertion := "", ""
		ferr := gomega.InterceptGomegaFailure(func() {
			switch {
			case st.Apply != nil:
				action = "apply"
				for _, obj := range st.Apply {
					prevdApply(obj)
				}
			case st.WaitFor != nil:
				action, assertion = "waitFor", st.WaitFor.Text
				gomega.Eventually(func(g gomega.Gomega) { prevdCheck(g, st.WaitFor) }).
					WithTimeout(time.Duration(st.WaitFor.TimeoutSeconds * float64(time.Second))).
					WithPolling(prevdPoll).Should(gomega.Succeed())
				pending = append(pending, st.WaitFor.Text)
			case st.Capture != nil:
				action, assertion = "capture", "state settles"
				gomega.Expect(pending).NotTo(gomega.BeEmpty(), "capture %q has no preceding assertion", st.Capture.Name)
				snap := prevdSettle(settle, window)
				raw.Checkpoints = append(raw.Checkpoints, prevdCheckpoint{Name: st.Capture.Name, Assertion: strings.Join(pending, "; "), Objects: snap})
				pending = nil
			case st.Patch != nil:
				action = "patch"
				u := &unstructured.Unstructured{}
				u.SetGroupVersionKind(prevdGVK(st.Patch.APIVersion, st.Patch.Kind))
				u.SetNamespace(st.Patch.Namespace)
				u.SetName(st.Patch.Name)
				pb, err := json.Marshal(st.Patch.Merge)
				gomega.Expect(err).NotTo(gomega.HaveOccurred())
				p := client.RawPatch(types.MergePatchType, pb)
				if st.Patch.Subresource == "status" {
					gomega.Expect(k8sClient.Status().Patch(ctx, u, p)).To(gomega.Succeed())
				} else {
					gomega.Expect(k8sClient.Patch(ctx, u, p)).To(gomega.Succeed())
				}
			case st.FinishEviction != nil:
				action = "finishEviction"
				assertion = fmt.Sprintf("Workload %s/%s is evicted", st.FinishEviction.Namespace, st.FinishEviction.Name)
				prevdevict.FinishEvictionForWorkloads(ctx, k8sClient, prevdWorkload(st.FinishEviction))
				pending = append(pending, assertion)
			case st.Finish != nil:
				action = "finish"
				prevdfinish.FinishWorkloads(ctx, k8sClient, prevdWorkload(st.Finish))
			case st.Delete != nil:
				action = "delete"
				u := &unstructured.Unstructured{}
				u.SetGroupVersionKind(prevdGVK(st.Delete.APIVersion, st.Delete.Kind))
				u.SetNamespace(st.Delete.Namespace)
				u.SetName(st.Delete.Name)
				gomega.Expect(client.IgnoreNotFound(k8sClient.Delete(ctx, u))).To(gomega.Succeed())
			default:
				gomega.Expect(fmt.Errorf("step %d has no known action", i)).NotTo(gomega.HaveOccurred())
			}
		})
		if ferr != nil {
			raw.Failure = &prevdFailure{Step: i, Action: action, Assertion: assertion, Message: ferr.Error()}
			if snapErr := gomega.InterceptGomegaFailure(func() { raw.Failure.Objects = prevdSnapshot() }); snapErr != nil {
				raw.Failure.Message += "\n(snapshot failed: " + snapErr.Error() + ")"
			}
			write()
			ginkgo.Fail(fmt.Sprintf("pr-evidence-state-diff: step %d (%s) failed: %v", i, action, ferr))
		}
	}
	write()
}

func prevdSetGates() {
	b, err := os.ReadFile(os.Getenv("PR_EVIDENCE_STATE_DIFF_SCENARIO"))
	gomega.Expect(err).NotTo(gomega.HaveOccurred())
	var sc prevdScenario
	gomega.Expect(json.Unmarshal(b, &sc)).To(gomega.Succeed())
	gates := map[featuregate.Feature]bool{}
	for k, v := range sc.FeatureGates {
		gates[featuregate.Feature(k)] = v
	}
	if len(gates) > 0 {
		prevdfeatures.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), gates)
	}
}

